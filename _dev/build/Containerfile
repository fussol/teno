FROM archlinux:latest AS builder

RUN pacman -Syu --noconfirm && \
    pacman -S --noconfirm \
    base-devel rust nodejs npm \
    webkit2gtk-4.1 libsoup3 \
    cairo glib2 gdk-pixbuf2 \
    atkmm pango openssl \
    && pacman -Scc --noconfirm

WORKDIR /build
COPY . .
RUN npm install && npx tauri build --no-bundle 2>&1

FROM scratch
COPY --from=builder /build/src-tauri/target/release/teno /teno
COPY --from=builder /build/src-tauri/resources/piper /piper
COPY --from=builder /build/src-tauri/icons/32x32.png /32x32.png
COPY --from=builder /build/src-tauri/icons/128x128.png /128x128.png
COPY --from=builder /build/src-tauri/icons/128x128@2x.png /128x128@2x.png
COPY --from=builder /build/Teno.desktop /Teno.desktop
