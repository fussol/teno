# Maintainer: Teno

pkgname=teno
pkgver=5.1.0
pkgrel=5
pkgdesc='Teno — English vocabulary learning app'
arch=('x86_64')
url='https://teno.app'
license=('custom:commercial')
depends=('webkit2gtk-4.1' 'libsoup3' 'gstreamer' 'gst-plugins-base' 'gst-plugins-good'
         'gst-plugins-bad' 'gst-plugins-ugly' 'gst-libav' 'glib2' 'gtk3'
         'cairo' 'pango' 'gdk-pixbuf2' 'atk' 'librsvg'
         'sqlite' 'libx11' 'ttf-font' 'espeak-ng')
makedepends=()
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

package() {
  local _dir="$srcdir/$pkgname-$pkgver"
  install -Dm755 "${_dir}/teno" "${pkgdir}/usr/lib/teno/teno"
  install -d "${pkgdir}/usr/bin"
  ln -s ../lib/teno/teno "${pkgdir}/usr/bin/teno"
  install -d "${pkgdir}/usr/lib/teno/resources"
  cp -r "${_dir}/piper" "${pkgdir}/usr/lib/teno/resources/piper"
  chmod +x "${pkgdir}/usr/lib/teno/resources/piper/piper" "${pkgdir}/usr/lib/teno/resources/piper/piper_phonemize" "${pkgdir}/usr/lib/teno/resources/piper/espeak-ng"
  install -Dm644 "${_dir}/Teno.desktop" "${pkgdir}/usr/share/applications/teno.desktop"
  for size in 32x32 128x128 128x128@2x; do
    install -Dm644 "${_dir}/${size}.png" \
      "${pkgdir}/usr/share/icons/hicolor/${size}/apps/teno.png"
  done
}
