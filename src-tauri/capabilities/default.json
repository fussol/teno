{
  "identifier": "default",
  "description": "Default capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "sql:default",
    "sql:allow-execute",
    "log:default",
    "dialog:default",
    "dialog:allow-save",
    "dialog:allow-open",
    "opener:default",
    "opener:allow-open-url"
  ]
}
