<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <!-- F6：Auto Backup 關閉（官方默認 true）。teno.db 與 Drive OAuth token 位於
         app_config_dir（非 no_backup/cache），預設會進使用者 Google Drive 雲端備份，
         新裝置恢復＝舊 DB 覆蓋現行 DB＋token 漂移，與 Drive sync（TENOC）官方通道打架。
         官方註記：targetSdk31+ 部分廠商裝置 allowBackup=false 不停 D2D 傳輸
         （Smart Switch 場景）——dataExtractionRules 補堵＝F6-SR1（白名單外改派）。 -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.teno"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true" />

        <!-- 動態換 icon：全部用 activity-alias（含預設 Icon1），MainActivity 本體不掛 LAUNCHER、永不禁用 -->
        <!-- ic_launcher_1 ~ ic_launcher_20 對應 original/ocean/.../ch10 -->
        <activity-alias
            android:name=".MainActivityIcon1"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/main_activity_title"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>
